<Project Sdk="Microsoft.NET.Sdk">

	<!--
		haru-tags: tag vocabulary and import into the site. Talks to the backend only through its
		HTTP API, except media_embeddings, which has no API and is written to Postgres directly.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>HaruyasumiRyokouki.DataTool.Tags</RootNamespace>
		<AssemblyName>haru-tags</AssemblyName>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="HaruyasumiRyokouki.DataTool.Tags.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.6.0" />
		<PackageReference Include="Npgsql" Version="8.0.6" />
		<PackageReference Include="OpenAI" Version="2.12.0" />
		<PackageReference Include="System.CommandLine" Version="2.0.14" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\HaruyasumiRyokouki.DataTool.Common\HaruyasumiRyokouki.DataTool.Common.csproj" />
	</ItemGroup>

</Project>
