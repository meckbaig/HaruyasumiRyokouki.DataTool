<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Отдельный одноразовый инструмент миграции. НЕ ССЫЛАЕТСЯ на проект сервера
		и ничего в нём не меняет: общение идёт по HTTP через уже существующий API.
		Можно держать в отдельном репозитории, можно удалить после миграции.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>TagsTool</RootNamespace>
		<AssemblyName>tagstool</AssemblyName>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<!-- Чтение photos.sqlite. -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.18" />
		<!-- Только для команды embeddings: у сервера нет и не будет API для
		     импорта векторов, поэтому эта одна команда пишет в Postgres сама.
		     Теги по-прежнему идут через HTTP API. -->
		<PackageReference Include="Npgsql" Version="8.0.6" />
	</ItemGroup>

</Project>
